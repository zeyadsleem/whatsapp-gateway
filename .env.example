# Environment for WhatsApp Gateway. Copy to .env and change every secret.
#   cp .env.example .env

# production | development
APP_ENV=production
APP_PORT=8080
APP_BASE_URL=https://wa.example.com

# Bind address for the published container port. Keep 127.0.0.1 when a
# reverse proxy (nginx/Caddy/Cloudflare Tunnel) terminates TLS on the host.
APP_BIND=127.0.0.1

# info | debug | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# PostgreSQL (used by the compose postgres container)
POSTGRES_USER=wg
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=whatsapp_gateway

# Full DSN used by the app. In docker compose the host is "postgres".
# For a local run without Docker use localhost instead.
POSTGRES_DSN=postgres://wg:change_me_strong_password@postgres:5432/whatsapp_gateway?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Admin API key. Minimum 32 characters, random. Generate with:
#   openssl rand -base64 48
ADMIN_API_KEY=change_me_at_least_32_characters_long_random

# Encrypts webhook secrets at rest with AES-256-GCM. Minimum 32 characters.
# Generate with: openssl rand -base64 48
APP_ENCRYPTION_KEY=change_me_at_least_32_characters_long_random

# Webhook delivery
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=3
WEBHOOK_WORKERS=4
WEBHOOK_QUEUE_SIZE=256

# Limits (per shop API key) and capacities
MAX_INSTANCES=100
MAX_UPLOAD_MB=16
SHOP_RATE_LIMIT_RPS=10
SHOP_RATE_LIMIT_BURST=20
ADMIN_RATE_LIMIT_RPS=20
ADMIN_RATE_LIMIT_BURST=40

# Comma-separated allowed browser origins for the admin API.
# Leave empty to allow same-origin only.
ALLOWED_ORIGINS=

# Graceful shutdown and per-send timeouts (seconds)
SHUTDOWN_TIMEOUT_SECONDS=15
SEND_TIMEOUT_SECONDS=30
